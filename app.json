{
  "expo": {
    "name": "Challenge Your Thoughts",
    "slug": "challenge-your-thoughts",
    "scheme": "challengeyourthoughts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.challengeyourthoughts.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to transcribe your speech on this device. Nothing is sent to a server.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone for on-device dictation. Audio never leaves your device.",
        "NSPhotoLibraryUsageDescription": "Challenge Your Thoughts does not access your photos. This text is required only because a built-in component could load images from your library."
      }
    },
    "android": {
      "package": "com.challengeyourthoughts.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDFDFD",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-video",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFDFD"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#5B8A72"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for on-device dictation. Audio never leaves your device.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to transcribe your speech on this device. Nothing is sent to a server."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./src/i18n/native/en.json",
      "de": "./src/i18n/native/de.json",
      "pt-BR": "./src/i18n/native/pt-BR.json"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "435d0eb4-8f83-40ae-9f94-b2baad3f45be"
      }
    }
  }
}
